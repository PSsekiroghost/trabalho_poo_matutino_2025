Banco de reservas de viagem:

create database sistema_viagens;

use sistema_viagens;

CREATE TABLE empresa (
    id_empresa INT PRIMARY KEY AUTO_INCREMENT, 
    nome VARCHAR(45),
    tipo VARCHAR(45),
    contato INT 
);

CREATE TABLE destino (
    id_destino INT PRIMARY KEY AUTO_INCREMENT,
    pais VARCHAR(45),
    estado VARCHAR(45),
    cidade VARCHAR(45)
);

CREATE TABLE passageiro (
    id_passageiro INT PRIMARY KEY AUTO_INCREMENT,
    nome VARCHAR(45),
    data_nascimento DATE,
    email VARCHAR(45),
    telefone VARCHAR(45)
);

CREATE TABLE viagem (
    id_viagem INT PRIMARY KEY AUTO_INCREMENT,
    data DATE,
    hora TIME,
    empresa_id_empresa INT,
    destino_id_destino INT,
    -- Configuração das Chaves Estrangeiras
    FOREIGN KEY (empresa_id_empresa) REFERENCES empresa(id_empresa),
    FOREIGN KEY (destino_id_destino) REFERENCES destino(id_destino)
);

CREATE TABLE reserva (
    id_reserva INT PRIMARY KEY AUTO_INCREMENT,
    data_reserva DATE,
    status TINYINT, -- Lembra: 1 para Confirmado, 0 para Pendente
    meio_pagamento VARCHAR(45),
    viagem_id_viagem INT,
    passageiro_id_passageiro INT,
    -- Configuração das Chaves Estrangeiras
    FOREIGN KEY (viagem_id_viagem) REFERENCES viagem(id_viagem),
    FOREIGN KEY (passageiro_id_passageiro) REFERENCES passageiro(id_passageiro)
);